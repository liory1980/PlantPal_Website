PLANTPAL_SITE_URL=https://www.plantpal.ai
CONTENT_API_KEY=use-the-same-secret-as-the-site
# Optional generation; leave empty for queue-only publishing.
OPENAI_API_KEY=
# Choose a model available to your API account that supports Responses,
# web_search, and Structured Outputs. No default model is forced.
CONTENT_MODEL=
# false saves AI output as local drafts. true explicitly enables automatic publication.
AUTO_PUBLISH=false
